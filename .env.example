# ─────────────────────────────────────────────────────────────────────────────
#  Environment variables. On cPanel add these in “Setup Node.js App” → your app
#  → Environment variables. Locally, put them in .env.local (never upload it).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Public address of the site, exactly as visitors type it (no trailing slash).
SERVER_URL=https://soheilsadeghi.com

# A long random secret (64+ characters). Keep it forever — changing it logs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=

# Database file (created automatically). Keep the data/ folder when you update the site.
DATABASE_URI=file:./data/soheil.db

# ── First admin account ──────────────────────────────────────────────────────
# Created on the very first start if no user exists yet. After you log in once,
# delete ADMIN_PASSWORD from the settings and change the password in the admin panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Soheil

# ── Email: sign-up confirmation, password reset, notifications for Soheil ─────
# Leave SMTP_HOST empty for no email: new accounts then work without confirmation.
# Ubuntu server (local Postfix, see ops/mail): SMTP_HOST=127.0.0.1, SMTP_PORT=25, no user/pass
#   — or simply run: sudo soheil-mail on
# External provider / cPanel mailbox: its host, port 465 (or 587) and SMTP_USER / SMTP_PASS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@soheilsadeghi.com
# Where new-student and booking notifications go (defaults to ADMIN_EMAIL)
NOTIFY_EMAIL=

# ── AI chat assistant (optional) ─────────────────────────────────────────────
# Without a key the assistant answers from its built-in knowledge base (editable in the admin).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Force a provider when both keys are set: anthropic | gemini
CHAT_PROVIDER=
# Default is the most capable model; claude-haiku-5-5 is much cheaper for a busy public widget.
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-flash-latest

# ── Telegram notification for new contact-form requests (optional) ────────────
# Requests are always saved in the admin panel (Inbox). With a bot you also get a Telegram message.
# Create a bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SMS notification via sms.ir (optional) ───────────────────────────────────
# Sends Soheil an SMS when a new student signs up or a contact request arrives — a backup for
# Telegram (blocked on the server). Get the API key and line number from the sms.ir panel.
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
# Mobile that receives the notifications (09xxxxxxxxx)
SMS_NOTIFY_MOBILE=
